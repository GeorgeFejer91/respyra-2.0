{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Respyra 2.0",
  "version": "0.3.7",
  "identifier": "dev.georgefejer.respyra2",
  "build": {
    "frontendDist": "../web",
    "beforeDevCommand": "pnpm prepare:web",
    "beforeBuildCommand": "pnpm prepare:web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{"label": "main", "title": "Respyra 2.0 — Experiment control", "width": 820, "height": 760, "minWidth": 360, "minHeight": 480}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost wss://wss.vdo.ninja https://turn.vdo.ninja; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {"active": false, "icon": ["icons/icon.ico", "icons/icon.png"]}
}
